{
  "expo": {
    "name": "Oh a Twill",
    "slug": "oh-a-twill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ohatwill",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.ohatwill",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick a picture to turn into a weaving pattern. It stays on your device.",
        "NSCameraUsageDescription": "Take a picture to turn into a weaving pattern. It stays on your device."
      }
    },
    "android": {
      "package": "com.example.ohatwill",
      "adaptiveIcon": {
        "backgroundColor": "#FFF3E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Oh a Twill",
      "shortName": "Oh a Twill",
      "lang": "en",
      "backgroundColor": "#FFF3E7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ]
  }
}
